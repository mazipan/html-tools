    "build": "npm run clean && node scripts/build.mjs && npm run clean:sorcemaps"
  },
  "license": "ISC",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "parcel": "^2.16.4",
    "parcel-namer-no-hash": "file:./parcel-namer-no-hash",
    "tailwindcss": "^4.2.4",
    "rimraf": "^6.1.3"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "npm": "11.12.1",
    "node": "24.15.0"
  }
}
