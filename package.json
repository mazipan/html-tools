{
  "name": "html-tools",
  "version": "1.0.0",
  "description": "Browser-native utilities",
  "scripts": {
    "clean": "rimraf ./dist ./.parcel-cache",
    "dev": "parcel 'src/[!_]*.html'",
    "build": "bun run clean && node scripts/build.mjs",
    "preview": "serve dist",
    "generate:og": "bun scripts/generate-og-image.mjs",
    "generate:favicon": "bun scripts/generate-favicon.mjs",
    "generate:sections": "bun scripts/generate-sections.mjs",
    "generate:index": "bun scripts/generate-index.mjs",
    "generate:readme": "bun scripts/generate-readme.mjs",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --write",
    "prepare": "[ -n \"$CI\" ] || lefthook install"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-jsonld": "^2.16.4",
    "@parcel/transformer-posthtml": "2.16.4",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/core": "^4.0.2",
    "@shikijs/engine-javascript": "^4.0.2",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@twemoji/svg": "^15.0.0",
    "browser-id3-writer": "^6.3.1",
    "buffer": "^6.0.3",
    "js-yaml": "4.3.1",
    "jsmediatags": "^3.9.7",
    "lefthook": "^2.1.6",
    "marked": "^18.0.3",
    "parcel": "^2.16.4",
    "posthtml-include": "2.0.1",
    "process": "^0.11.10",
    "rimraf": "^6.1.3",
    "semver": "^7.8.0",
    "serve": "14.2.6",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.3.0"
  },
  "packageManager": "bun@1.2.17",
  "engines": {
    "bun": ">=1.2.0"
  },
  "browserslist": "> 0.5%, last 2 versions, Firefox ESR, not dead",
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284"
  }
}
