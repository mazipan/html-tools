{
  "name": "html-tools",
  "version": "1.0.0",
  "description": "Browser-native utilities",
  "scripts": {
    "clean": "rimraf ./dist ./.parcel-cache",
    "dev": "parcel 'src/*.html'",
    "build": "npm run clean && node scripts/build.mjs",
    "preview": "serve dist",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:sections": "node scripts/generate-sections.mjs",
    "generate:index": "node scripts/generate-index.mjs"
  },
  "license": "ISC",
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-jsonld": "^2.16.4",
    "@parcel/transformer-posthtml": "2.16.4",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/core": "^4.0.2",
    "@shikijs/engine-javascript": "^4.0.2",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@twemoji/svg": "^15.0.0",
    "js-yaml": "4.1.1",
    "marked": "^18.0.3",
    "parcel": "^2.16.4",
    "posthtml-include": "2.0.1",
    "rimraf": "^6.1.3",
    "semver": "^7.8.0",
    "serve": "14.2.6",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.3.0"
  },
  "packageManager": "npm@11.14.1",
  "engines": {
    "npm": "11.14.1",
    "node": "24.15.0"
  },
  "browserslist": "> 0.5%, last 2 versions, Firefox ESR, not dead",
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
